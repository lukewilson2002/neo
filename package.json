{
  "name": "neo",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "description": "One command to get an isolated database for your branch",
  "bin": {
    "neo": "./src/index.ts"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "test": "bun test",
    "test:unit": "bun test tests/unit",
    "test:integration": "bun test tests/integration",
    "test:e2e": "bun test tests/e2e",
    "test:cleanup": "bun run tests/helpers/cleanup-orphans.ts",
    "typecheck": "tsc --noEmit",
    "build": "bun build src/index.ts --compile --outfile neo"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "smol-toml": "^1.6.0",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.11",
    "typescript": "^5.9.3"
  }
}
